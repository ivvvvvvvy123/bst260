library(NHANES)
data(NHANES)
library(dplyr)
library(table1)
library(ggplot2)
nh11 = NHANES |> filter(SurveyYr == "2011_12")
#| tbl-cap: "Basic DBP statistics for females"
#| results: asis
table1(~BPDiaAve|Race3, data=nh11 |> filter(Sex=="female"))
#| tbl-cap: "Basic DBP statistics for males"
#| results: asis
table1(~BPDiaAve|Race3, data=nh11 |> filter(Sex=="male"))
#| tbl-cap: "Basic DBP statistics for females"
#| results: asis
nh11 |>
group_by(Sex,Race3) |>
summarise(
mean = mean(BPDiaAve,na.rm = TRUE), #to remove/ignore missing values
sd = sd(BPDiaAve, na.rm = TRUE),
nmiss = sum(is.na(BPDiaAve)),
.groups ='drop'
) |>
arrange(Sex, Race3)
summary(nh11$BPDiaAve)
nh11 |>
arrange(BPDiaAve)|>
select(Sex, Race3,Age, BPDiaAve)|>
head(10)
nh11 |>
summarise(
zero=sum(BPDiaAve ==0, na.rm = TRUE),
missed = sum(is.na(BPDiaAve)),
total_rows = n()
)
nh11_clean <- nh11 |>
mutate(BPDiaAve = na_if(BPDiaAve,0))
sum(is.na(nh11_clean$BPDiaAve))
dplyr_means<- nh11_clean |>
group_by(Sex,Race3) |>
summarise(
mean = mean(BPDiaAve,na.rm = TRUE), #to remove/ignore missing values
sd = sd(BPDiaAve, na.rm = TRUE),
nmiss = sum(is.na(BPDiaAve)),
.groups ='drop'
) |>
arrange(Sex, Race3)
dplyr_means
table1(~BPDiaAve|Race3, data=nh11_clean |> filter(Sex=="female"))
table1(~BPDiaAve|Race3, data=nh11_clean |> filter(Sex=="male"))
lm1 = lm(BPDiaAve~Race3*Sex-1, data=nh11, na.action=na.omit)
lm1$coef
lm1_clean = lm(BPDiaAve ~ Race3*Sex-1, data= nh11_clean) #-1 remove intercept, so each race has its own coef.
lm1_clean$coef #asian as reference race, female as reference gender.
coef(lm1_clean)[1:6]
dplyr_means|> filter(Sex == 'female')|>
select(mean)
cf <- coef(lm1_clean)
female <- cf[1:6]
baseline <-cf['Sexmale']
ext <-c(0,cf[8:12])
male <-female +baseline +ext #cf['Race3Black']+cf['Sexmale']+cf['Race3Black:Sexmale']
male
dplyr_means |> filter(Sex == "male") |> select(Race3, mean)
compare <- dplyr_means|>
mutate(lm_mean =c(female,male))
compare
all.equal(compare$mean, compare$lm_mean, check.attributes = FALSE)
par(mfrow=c(3,2),las=2,mar=c(5,4,2,2))
ss = split(nh11, nh11$Race3)
tt = lapply(names(ss), function(x) {d = ss[[x]];
boxplot(split(d$BPDiaAve, d$AgeDecade), main=x, ylim=c(0,120))})
ggplot(data = nh11, aes(x=AgeDecade,y=BPDiaAve))+ # for each graph sets x and y
geom_boxplot(fill ='grey80',color='black',na.rm=TRUE,outlier.shape=1)+ #boxplot
facet_wrap(~ Race3,ncol=2) +# split into race and have a 3*2 layout
scale_x_discrete(na.translate = FALSE)+
scale_y_continuous(breaks = seq(0, 120, by = 20))+
coord_cartesian(ylim=c(0,120))+ #mar=c(5,4,2,2))+
theme_classic()+
theme(
axis.text.x =element_text(angle = 90, hjust =1),
strip.background = element_blank(),
strip.text = element_text(face = "bold"),
panel.border = element_rect(color = "black", fill = NA)
) #las =2
with(nh11, table(AgeDecade, Race3))
lm_age <- lm(Age ~ Race3*Sex - 1, data = nh11)
cf_age <- coef(lm_age)
female_age <-cf_age[1:6]
male_age <- cf_age[1:6]+cf_age['Sexmale']+c(0,cf_age[8:12])
age_res<- data.frame(
Race3 =levels(nh11_clean$Race3),
female =round(female_age,1),
male = round(male_age,1),
row.names =NULL
)
age_res
observed <-with(nh11, table(AgeDecade, Race3))
observed
expected <- outer( # get a 8 by 6 table
rowSums(observed),# total number for each age group
colSums(observed) # total number for each race
)/sum(observed) # divider by total number: /n
expected
all.equal(expected, chisq.test(observed)$expected, check.attributes = FALSE)
